# Alpaca API credentials. Create a key pair at https://app.alpaca.markets/
# (use the paper-trading dashboard for a paper key, or the live dashboard for a
# live key -- they are different key pairs).
ALPACA_API_KEY=
ALPACA_API_SECRET=

# ALPACA_IS_PAPER selects which Alpaca endpoint/account these credentials talk to.
#   true  (default) -> paper trading: a simulated account, no real money at risk.
#   false            -> LIVE TRADING WITH REAL MONEY. Orders submitted while this
#                       is false use real funds in a real brokerage account.
# Only set this to false once you are certain you want to trade live.
ALPACA_IS_PAPER=true
