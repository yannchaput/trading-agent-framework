# Alpaca API credentials. Create a key pair at https://app.alpaca.markets/
# (use the paper-trading dashboard for a paper key, or the live dashboard for a
# live key -- they are different key pairs).
ALPACA_API_KEY=
ALPACA_API_SECRET=

# ALPACA_IS_PAPER selects which Alpaca endpoint/account these credentials talk to.
#   true  (default) -> paper trading: a simulated account, no real money at risk.
#   false            -> LIVE TRADING WITH REAL MONEY. Orders submitted while this
#                       is false use real funds in a real brokerage account.
# Only set this to false once you are certain you want to trade live.
ALPACA_IS_PAPER=true

# LLM connection for the agent framework (Strategy.agents / create_agent). Works
# against any OpenAI-compatible server -- vLLM, llama.cpp, LM Studio, or real
# OpenAI.
LLM_BASE_URL=http://localhost:8000/v1

# Default model id used when Strategy.agents.create(...) is called without an
# explicit `model=`. Individual agents may override this per-call.
LLM_MODEL=qwen3-8b

# Most local OpenAI-compatible servers ignore this value, but the OpenAI SDK
# requires a non-blank string to construct the client. Use any placeholder.
LLM_API_KEY=not-needed-for-local

# FRED (Federal Reserve Economic Data) API key for agents/tools/macro.py.
# Get one at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Identity string SEC EDGAR requires on every request (fair-access policy):
# "<app or project name> <contact email>". Requests without one may be blocked.
SEC_EDGAR_USER_AGENT=
